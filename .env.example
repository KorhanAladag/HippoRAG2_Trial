# =============================================================================
# Copy this file to .env and adjust. NEVER commit .env itself.
#
#   cp .env.example .env
#
# This file is the contract: it documents every variable the application reads.
# A new engineer should be able to clone the repo, copy this file, fill in the
# secrets, and run. Keep it in sync when you add a setting.
#
# Convention used here: values shown are the defaults that config.py falls back
# to when the variable is absent. Secrets are left blank on purpose.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# One of: development, staging, production
# Controls log verbosity and whether config validation is strict.
APP_ENV=development

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# LLM endpoint (Ollama, vLLM, or any OpenAI compatible server)
# -----------------------------------------------------------------------------
# Chat completions endpoint. Ollama's default port is 11434.
LLM_BASE_URL=http://localhost:11434/v1

# Embeddings endpoint. Note the different path.
EMBEDDING_BASE_URL=http://localhost:11434/v1/embeddings

# Ollama ignores this, but a hosted provider will not. SECRET: leave blank here.
LLM_API_KEY=

# Builds triples during indexing and filters them at query time.
# Structural, repetitive work, so a mid size model is enough.
EXTRACTION_MODEL=qwen2.5:7b-instruct

# Writes the final answer. Answer quality is decided here, so this is the
# place to spend a larger model if you have the memory for it.
GENERATION_MODEL=qwen2.5:7b-instruct

# Turns text into vectors. Not an LLM. bge-m3 is 1024 dimensional and handles
# technical text and multiple languages better than smaller alternatives.
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=16


# -----------------------------------------------------------------------------
# Vector store
# -----------------------------------------------------------------------------
# parquet | qdrant | chroma | milvus
#
# parquet is HippoRAG's default and loads every embedding into the Python
# process: roughly 0.85 MB per passage, so about 85 GB at 100k passages.
# Switching later means re-embedding the whole corpus, so start on qdrant.
VECTOR_STORE_TYPE=qdrant

# Leave blank for a local file based Qdrant inside the save directory.
QDRANT_URL=http://localhost:6333

# SECRET: required for Qdrant Cloud or a secured instance. Blank locally.
QDRANT_API_KEY=


# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
# HippoRAG creates a subfolder per model pair under this directory, so
# changing a model never silently mixes two graphs together.
SAVE_DIR=outputs
DOCS_FOLDER=docs
METRICS_FILE=build_metrics.json


# -----------------------------------------------------------------------------
# Chunking
# -----------------------------------------------------------------------------
CHUNK_MAX_TOKENS=1000
CHUNK_OVERLAP_TOKENS=100


# -----------------------------------------------------------------------------
# Graph construction
# -----------------------------------------------------------------------------
# The strongest lever on graph size. Around four fifths of all edges are
# synonym edges, created whenever two phrases sit above this cosine threshold.
# Raise to 0.85 for a smaller graph, lower for better recall. Worth sweeping.
SYNONYMY_THRESHOLD=0.8


# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
# Phrase nodes used as PPR seeds after the triple filter.
LINKING_TOP_K=5

# Candidate passages scored before PPR reranking.
RETRIEVAL_TOP_K=200

# Passages actually sent to the answer model. Lower is faster and cheaper,
# at some cost to recall.
QA_TOP_K=5
